<a href="javascript:;" id="gotop" class="waves-effect waves-circle waves-light"><span class="icon icon-lg icon-chevron-up"></span></a>
<% if(theme.share){ %>
<%- partial('post/share', {scope: 'global'}) %>
<% } %>
<script>
/* 算法演示 iframe 自适应高度：iframe 与站点同源，直接按内容高度撑开，
   避免 article.less 里的固定 780px 把演示截断或逼出内部滚动条。 */
(function () {
    function fit(frame) {
        if (!frame) return;
        try {
            var doc = frame.contentDocument;
            if (!doc || !doc.body) return;
            var h = Math.max(doc.documentElement.scrollHeight, doc.body.scrollHeight);
            if (h > 200) frame.style.height = Math.min(h + 4, 2400) + 'px';
        } catch (e) { /* 跨域则保持 CSS 高度 */ }
    }
    function fitAll() {
        Array.prototype.forEach.call(document.querySelectorAll('.algo-demo iframe'), fit);
    }
    function init() {
        Array.prototype.forEach.call(document.querySelectorAll('.algo-demo iframe'), function (frame) {
            fit(frame);
            frame.addEventListener('load', function () {
                fit(frame);
                setTimeout(function () { fit(frame); }, 400);
                setTimeout(function () { fit(frame); }, 1500);
            });
        });
        fitAll();
    }
    if (document.readyState === 'complete') init();
    else window.addEventListener('load', init);
    window.addEventListener('resize', fitAll);
})();
</script>

